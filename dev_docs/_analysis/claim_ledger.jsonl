{"id": "rust_loc", "claim": "Rust 源码 1,270,789 行", "kind": "count", "expected": "1270789", "verify": "git ls-files '*.rs' | xargs wc -l 2>/dev/null | tail -1 | awk '{print $1}'", "evidence_level": "E4", "sources": [], "note": "wc -l 口径，含空行与注释，含测试与快照辅助文件", "round": 5}
{"id": "tracked_files_upstream", "claim": "Git 跟踪文件 5,913 个（不含本文档体系）", "kind": "count", "expected": "5913", "verify": "git ls-files | grep -vc '^dev_docs/'", "evidence_level": "E4", "sources": [], "note": "关键口径：git ls-files 全量为 5,938，差额 25 恰为 dev_docs/ 自身。原数字未注明口径，本轮补注", "round": 5}
{"id": "shipped_aux_binaries", "claim": "随正式发布交付 6 个辅助可执行文件（不含主二进制 codex）", "kind": "count", "expected": "", "verify": "grep -hoE '(WINDOWS_)?[Bb]inaries: \"[^\"]*\"' .github/workflows/rust-release.yml .github/workflows/rust-release-windows.yml | sed -E 's/^[^\"]*\"//; s/\"$//' | tr ' ' '\\n' | grep -v '^codex$' | grep -v '^$' | sort -u | wc -l | tr -d ' '", "pattern": "(\\d{1,2})\\s*个(?:随发布交付的)?辅助可执行文件", "evidence_level": "E4", "sources": [".github/workflows/rust-release.yml", ".github/workflows/rust-release-windows.yml"], "note": "expected 留空表示本轮待复核确认", "round": 5}
