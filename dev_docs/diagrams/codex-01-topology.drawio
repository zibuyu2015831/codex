        <mxCell id="appsrv" value="codex-app-server&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JSON-RPC，供 IDE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lFront">
