        <mxCell id="mcpsrv" value="codex-mcp-server&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;把自己变成工具&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lFront">
