<mxfile host="app.diagrams.net">
  <diagram name="全局拓扑" id="topology">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Codex 全局拓扑：一个二进制，五种形态" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="440" height="50" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;橙 = 体量重心（codex-core）&lt;br&gt;紫 = 前端 / 适配层&lt;br&gt;绿 = 本地持久化&lt;br&gt;红 = 安全隔离&lt;br&gt;红虚线 = CI 强制的禁止直连&lt;br&gt;灰虚线 = 实验性通路&lt;br&gt;&lt;br&gt;&lt;i&gt;注：CI 禁的是「直接依赖 / 直接 import」。&lt;br&gt;codex-core 仍会经中间 crate 传递性链接&lt;br&gt;进 TUI —— 两者并不矛盾。&lt;/i&gt;" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="300" width="340" height="250" as="geometry" />
        </mxCell>

        <mxCell id="user" value="你 / IDE / SDK" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="主二进制 codex&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;codex-rs/cli · 27 个子命令分发&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lFront" value="前端 / 服务端" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="1120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tui" value="codex-tui&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;交互式终端&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lFront">
          <mxGeometry x="20" y="50" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="exec" value="codex-exec&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;非交互，供脚本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lFront">
          <mxGeometry x="240" y="50" width="200" height="70" as="geometry" />
